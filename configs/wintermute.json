{
  "database": {
    "path": "wintermute.db"
  },
  "scanner": {
    "subnets": ["192.168.1.0/24"],
    "scan_interval": "5m",
    "timeout": "2s",
    "workers": 50,
    "max_hosts": 65535
  },
  "log": {
    "level": "info",
    "format": "text"
  },
  "health": {
    "addr": "127.0.0.1:8080"
  },
  "admin": {
    "addr": "127.0.0.1:9090"
  },
  "watchdog": {
    "peer_addr": "http://localhost:8081",
    "interval": "30s",
    "max_host_drift_pct": 50.0,
    "max_failures": 3
  }
}
