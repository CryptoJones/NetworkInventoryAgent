{
  "database": {
    "path": "neuromancer.db"
  },
  "scanner": {
    "subnets": ["192.168.1.0/24"],
    "scan_interval": "5m",
    "timeout": "2s"
  },
  "log": {
    "level": "info",
    "format": "text"
  },
  "health": {
    "addr": "127.0.0.1:8081"
  },
  "watchdog": {
    "peer_addr": "http://localhost:8080",
    "interval": "30s",
    "max_host_drift_pct": 50.0,
    "max_failures": 3
  }
}
